// Draws the highest high and lowest low of the last N bars, with the midline between them.
indicator("Donchian channel", overlay=true)
len = input.int(20, "Length", min=1, max=300)

upper = ta.highest(high, len)
lower = ta.lowest(low, len)
middle = math.avg(upper, lower)

upperLine = plot(upper, "Upper", color=color.blue)
lowerLine = plot(lower, "Lower", color=color.blue)
plot(middle, "Middle", color=color.gray)
fill(upperLine, lowerLine, color.new(color.blue, 92))
