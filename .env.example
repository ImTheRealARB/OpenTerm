# OpenTerm runs with zero keys. Add keys to unlock extra providers.
# Copy to .env (never commit .env). Keys are read by the backend only.

OPENTERM_HOST=127.0.0.1
OPENTERM_PORT=8000
OPENTERM_DB_PATH=data/openterm.db

# SEC EDGAR requires a descriptive User-Agent with contact info.
SEC_USER_AGENT="OpenTerm/0.1 you@example.com"

# Optional provider keys (phase 2+)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
