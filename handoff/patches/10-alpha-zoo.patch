+
+Formula (verbatim from the report):
+    REGBETA(MEAN(CLOSE,12), SEQUENCE(12))
+
+Notes: Rolling OLS slope of MA12 against linear index, window 12.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+from openterm.quantlib.alpha.base import (
+    decay_linear,
+    delta,
+    rank,
+    safe_div,
+    scale,
+    signed_power,
+    ts_argmax,
+    ts_argmin,
+    ts_corr,
+    ts_cov,
+    ts_max,
+    ts_mean,
+    ts_min,
+    ts_rank,
+    ts_std,
+)
+
+ALPHA_ID = "gtja191_147"
+
+__alpha_meta__ = {
+    'id': 'gtja191_147',
+    'theme': ['momentum'],
+    'formula_latex': 'regbeta(mean(close,12),sequence(12))',
+    'columns_required': ['close'],
+    'extras_required': [],
+    'universe': ['equity_cn'],
+    'frequency': ['1d'],
+    'decay_horizon': 12,
+    'min_warmup_bars': 23,
+    'notes': 'Rolling OLS slope of MA12 against linear index, window 12.',
+}
+
+
+def compute(panel):
+    """Compute gtja191_147.
+
+    Args:
+        panel: dict[str, pd.DataFrame] with at least the required columns.
+
+    Returns:
+        pd.DataFrame with index = panel["close"].index, columns = panel["close"].columns.
+    """
+    c = panel["close"]
+    n = 12
+    m = ts_mean(c, 12)
+    t = pd.DataFrame(
+        np.tile(np.arange(c.shape[0], dtype=np.float64).reshape(-1, 1), (1, c.shape[1])),
+        index=c.index, columns=c.columns,
+    )
+    out = safe_div(ts_cov(m, t, n), ts_std(t, n) ** 2)
+    return out
