+# ============================================================
+# 中文名称: 收益率-量变化相关性 10日
+# 简要说明: ts_corr(close/close_prev, log(v/v_prev + 1), 10)，10日价格变化与对数量变比的相关系数。
+# 典型用途: 衡量10日价格变动与成交量变动的相关性，反映量价配合程度。
+# ============================================================
+"""qlib158 CORD10: formula = \\mathrm{ts\\_corr}(\\mathrm{close}/\\mathrm{close}_{{-1}}, \\log(\\mathrm{volume}/\\mathrm{volume}_{{-1}} + 1), 10)."""
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+from openterm.quantlib.alpha.base import safe_div, ts_corr
+
+__alpha_meta__ = {
+    'id': 'qlib158_cord10',
+    'theme': ['volume', 'microstructure'],
+    'formula_latex': '\\\\mathrm{ts\\\\_corr}(\\\\mathrm{close}/\\\\mathrm{close}_{{-1}}, \\\\log(\\\\mathrm{volume}/\\\\mathrm{volume}_{{-1}} + 1), 10)',
+    'columns_required': ['close', 'volume'],
+    'universe': ['equity_us', 'equity_cn', 'equity_hk', 'equity_in', 'equity_kr'],
+    'frequency': ['1d'],
+    'decay_horizon': 10,
+    'min_warmup_bars': 11,
+}
+
+
+def compute(panel: dict[str, pd.DataFrame]) -> pd.DataFrame:
+    """Return qlib158 CORD10 on the supplied OHLCV panel."""
+    c = panel['close']
+    v = panel['volume']
+    c_ret = safe_div(c, c.shift(1))
+    v_ret = safe_div(v, v.shift(1)) + 1.0
+    logvr = np.log(v_ret)
+    return ts_corr(c_ret, logvr, 10)
