+__alpha_meta__ = {
+    'id': 'gtja191_143',
+    'theme': ['momentum'],
+    'formula_latex': 'cumprod(1 + (c/delay(c,1)-1) if c>delay(c,1) else 0)',
+    'columns_required': ['close'],
+    'extras_required': [],
+    'universe': ['equity_cn'],
+    'frequency': ['1d'],
+    'decay_horizon': 1,
+    'min_warmup_bars': 2,
+    'notes': 'Recursive SELF unrolled to cumulative product of (1 + up_return) since series start.',
+}
+
+
+def compute(panel):
