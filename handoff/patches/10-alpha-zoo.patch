+# Ported from HKUDS/Vibe-Trading @ 8b8e083, agent/src/factors/zoo/qlib158/rsv20.py (MIT; see THIRD_PARTY.md).
+# Changes: imports only; a per-file `ruff: noqa` header covers lint (unused imports, import order, style).
+# ruff: noqa
+# Adapted from microsoft/qlib@d5379c520f66a39953bad76234a7019a72796fd0:qlib/contrib/data/handler.py
+# (Apache-2.0). Copyright (c) Microsoft Corporation.
+# ============================================================
+# 中文名称: 未成熟随机值 20日
+# 简要说明: (close - ts_min(low, 20)) / (ts_max(high, 20) - ts_min(low, 20))，KDJ指标中的RSV值。
+# 典型用途: 衡量收盘价在20日高低区间中的位置，用于超买超卖判断(>80超买，<20超卖)。
+# ============================================================
+"""qlib158 RSV20: formula = (\\mathrm{close} - \\mathrm{ts\\_min}(\\mathrm{low}, 20)) / (\\mathrm{ts\\_max}(\\mathrm{high}, 20) - \\mathrm{ts\\_min}(\\mathrm{low}, 20))."""
+from __future__ import annotations
+
+import pandas as pd
+from openterm.quantlib.alpha.base import safe_div, ts_max, ts_min
+
+__alpha_meta__ = {
+    'id': 'qlib158_rsv20',
+    'theme': ['momentum'],
+    'formula_latex': '(\\\\mathrm{close} - \\\\mathrm{ts\\\\_min}(\\\\mathrm{low}, 20)) / (\\\\mathrm{ts\\\\_max}(\\\\mathrm{high}, 20) - \\\\mathrm{ts\\\\_min}(\\\\mathrm{low}, 20))',
+    'columns_required': ['high', 'low', 'close'],
+    'universe': ['equity_us', 'equity_cn', 'equity_hk', 'equity_in', 'equity_kr'],
+    'frequency': ['1d'],
+    'decay_horizon': 20,
+    'min_warmup_bars': 20,
+}
+
+
+def compute(panel: dict[str, pd.DataFrame]) -> pd.DataFrame:
+    """Return qlib158 RSV20 on the supplied OHLCV panel."""
+    c = panel['close']
+    h = panel['high']
+    lo = panel['low']
+    hh = ts_max(h, 20)
+    ll = ts_min(lo, 20)
+    return safe_div(c - ll, hh - ll)
