+# 简要说明: 国泰君安191短周期交易型alpha因子第191号，详见公式定义。
+# 典型用途: 在A股市场经中性化处理后用于选股或股指期货日内交易。
+# ============================================================
+"""GTJA Alpha 191 (国泰君安 191 短周期交易型 alpha 因子, 2014).
+
+Formula (verbatim from the report):
+    ((CORR(MEAN(VOLUME,20), LOW, 5) + ((HIGH + LOW) / 2)) - CLOSE)
+
+Notes: 
+"""
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+from openterm.quantlib.alpha.base import (
+    decay_linear,
+    delta,
+    rank,
+    safe_div,
+    scale,
+    signed_power,
+    ts_argmax,
+    ts_argmin,
+    ts_corr,
+    ts_cov,
+    ts_max,
+    ts_mean,
+    ts_min,
+    ts_rank,
+    ts_std,
+)
+
+ALPHA_ID = "gtja191_191"
+
+__alpha_meta__ = {
+    'id': 'gtja191_191',
+    'theme': ['volume'],
+    'formula_latex': '((CORR(MEAN(VOLUME,20), LOW, 5) + ((HIGH + LOW) / 2)) - CLOSE)',
+    'columns_required': ['open', 'high', 'low', 'close', 'volume'],
+    'extras_required': [],
+    'universe': ['equity_cn'],
+    'frequency': ['1d'],
+    'decay_horizon': 20,
+    'min_warmup_bars': 24,
+    'notes': '',
+}
+
+
+def compute(panel):
+    """Compute gtja191_191.
+
+    Args:
+        panel: dict[str, pd.DataFrame] with at least the required columns.
+
+    Returns:
+        pd.DataFrame with index = panel["close"].index, columns = panel["close"].columns.
+    """
+    c = panel["close"]
+    h = panel["high"]
+    l = panel["low"]
+    v = panel["volume"]
+    out = (ts_corr(ts_mean(v, 20), l, 5) + (h + l) / 2.0) - c
+    return out
