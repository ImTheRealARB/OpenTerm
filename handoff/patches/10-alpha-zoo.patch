+    """
+    v = panel["volume"]
+    vw = vwap(panel, "equity_cn")
+
+    left = rank(vw - ts_min(vw, 12))
+    inner = ts_corr(ts_rank(vw, 20), ts_rank(ts_mean(v, 60), 2), 18)
