+
+Formula: COUNT((CLOSE>OPEN & BENCHMARKINDEXCLOSE<DELAY(BENCHMARKINDEXCLOSE,1)),50)/COUNT(BENCHMARKINDEXCLOSE<DELAY(BENCHMARKINDEXCLOSE,1),50)
+Source: 国泰君安 191 alpha 研报 (2014), alpha 75."""
+
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+from openterm.quantlib.alpha.base import (
+    decay_linear,
+    delta,
+    rank,
+    safe_div,
+    signed_power,
+    ts_argmax,
+    ts_argmin,
+    ts_corr,
+    ts_cov,
+    ts_max,
+    ts_mean,
+    ts_min,
+    ts_rank,
+    ts_std,
+)
+
+__alpha_meta__ = {
+    "id": "gtja191_075",
+    "theme": ['sentiment', 'momentum'],
+    "formula_latex": 'COUNT((CLOSE>OPEN & BENCHMARKINDEXCLOSE<DELAY(BENCHMARKINDEXCLOSE,1)),50)/COUNT(BENCHMARKINDEXCLOSE<DELAY(BENCHMARKINDEXCLOSE,1),50)',
+    "columns_required": ['close', 'open'],
+    "extras_required": [],
+    "requires_sector": False,
+    "universe": ["equity_cn"],
+    "frequency": ["1d"],
+    "decay_horizon": 50,
+    "min_warmup_bars": 51,
+    "notes": 'Benchmark unavailable in zoo panel; degraded to row-mean(close) as benchmark proxy. Original 50-observation count window.',
+}
+
+def compute(panel: dict) -> pd.DataFrame:
+    c = panel["close"]
+    o = panel["open"]
+    bench_row = c.mean(axis=1).to_numpy(dtype=float)
+    bench_df = pd.DataFrame(np.broadcast_to(bench_row[:, None], c.shape).copy(),
+                            index=c.index, columns=c.columns)
+    observed = bench_df.notna() & bench_df.shift(1).notna()
+    bench_down = (bench_df < bench_df.shift(1)).astype(float).where(observed)
+    # A bar with a missing open/close is not an up bar (#1463).
+    up_and_down = ((c > o) & (bench_df < bench_df.shift(1))).astype(float).where(c.notna() & o.notna() & observed)
+    num = up_and_down.rolling(50, min_periods=50).sum()
+    den = bench_down.rolling(50, min_periods=50).sum()
+    return safe_div(num, den)
