+# 典型用途: 均线趋势变化与当前偏离度的综合信号。
+# ============================================================
+"""GTJA Alpha #53.
+
+Formula: COUNT(CLOSE>DELAY(CLOSE,1),12)/12*100
+Source: 国泰君安 191 alpha 研报 (2014), alpha 53."""
+
+from __future__ import annotations
+
+import numpy as np
