+__alpha_meta__ = {
+    'id': 'gtja191_187',
+    'theme': ['reversal'],
+    'formula_latex': 'SUM((OPEN<=DELAY(OPEN,1) ? 0 : MAX(HIGH-OPEN, OPEN-DELAY(OPEN,1))), 20)',
+    'columns_required': ['open', 'high'],
+    'extras_required': [],
+    'universe': ['equity_cn'],
+    'frequency': ['1d'],
+    'decay_horizon': 20,
+    'min_warmup_bars': 21,
+    'notes': '',
+}
+
+
+def compute(panel):
+    """Compute gtja191_187.
+
+    Args:
+        panel: dict[str, pd.DataFrame] with at least the required columns.
+
+    Returns:
+        pd.DataFrame with index = panel["close"].index, columns = panel["close"].columns.
+    """
+    o = panel["open"]
+    h = panel["high"]
+    prev = o.shift(1)
+    cond = (o <= prev).astype("float64")
+    arr_a = (h - o).to_numpy(dtype=np.float64, na_value=np.nan)
+    arr_b = (o - prev).to_numpy(dtype=np.float64, na_value=np.nan)
+    mx = pd.DataFrame(np.maximum(arr_a, arr_b), index=o.index, columns=o.columns)
+    val = mx * (1.0 - cond)
+    out = val.rolling(20).sum()
+    return out
