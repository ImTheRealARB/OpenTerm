+    p1 = rank(decay_linear(delta(blend, 2), 3))
+    p2 = ts_rank(decay_linear(ts_corr(ts_mean(v, 180), c, 13).abs(), 5), 15)
+    return -1.0 * pd.DataFrame(np.maximum(p1.to_numpy(), p2.to_numpy()),
