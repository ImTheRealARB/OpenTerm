+ALPHA_ID = "gtja191_121"
+
+__alpha_meta__ = {
+    'id': 'gtja191_121',
+    'theme': ['volume'],
+    'formula_latex': '((RANK((VWAP-MIN(VWAP,12)))^TSRANK(CORR(TSRANK(VWAP,20),TSRANK(MEAN(VOLUME,60),2),18),3))*-1)',
+    'columns_required': ['open', 'high', 'low', 'close', 'volume', 'amount'],
+    'extras_required': [],
+    'universe': ['equity_cn'],
+    'frequency': ['1d'],
+    'decay_horizon': 60,
+    'min_warmup_bars': 80,
+    'notes': '',
+}
