+"""Kakushadze Alpha #46.
+
+Formula (paper appendix): complex piecewise; see paper
+Source: Kakushadze (2015), "101 Formulaic Alphas", arXiv:1601.00991, eq. 46.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+from openterm.quantlib.alpha.base import (
+    decay_linear,
+    delta,
+    rank,
+    safe_div,
+    scale,
