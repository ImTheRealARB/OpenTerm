+# Ported from HKUDS/Vibe-Trading @ 8b8e083, agent/src/factors/zoo/gtja191/alpha_033.py (MIT; see THIRD_PARTY.md).
+# Changes: imports only; a per-file `ruff: noqa` header covers lint (unused imports, import order, style).
+# ruff: noqa
+
+# ============================================================
+# 中文名称: GTJA #33 - 量价秩相关
+# 简要说明: RANK(-1*CORR(RANK(OPEN),RANK(VOLUME),10))，开盘价与成交量10日秩相关取负后排名。
+# 典型用途: 开盘量价背离的标准化排名信号。
+# ============================================================
+"""GTJA Alpha #33.
+
+Formula: ((((-1*TSMIN(LOW,5))+DELAY(TSMIN(LOW,5),5))*RANK(((SUM(RET,240)-SUM(RET,20))/220)))*TSRANK(VOLUME,5))
+Source: 国泰君安 191 alpha 研报 (2017-06-15), alpha 33."""
+
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+from openterm.quantlib.alpha.base import (
+    decay_linear,
+    delta,
+    rank,
+    safe_div,
+    signed_power,
+    ts_argmax,
+    ts_argmin,
+    ts_corr,
+    ts_cov,
+    ts_max,
+    ts_mean,
+    ts_min,
+    ts_rank,
+    ts_std,
+)
+
+__alpha_meta__ = {
+    "id": "gtja191_033",
+    "theme": ['momentum', 'volume'],
+    "formula_latex": '((((-1*TSMIN(LOW,5))+DELAY(TSMIN(LOW,5),5))*RANK(((SUM(RET,240)-SUM(RET,20))/220)))*TSRANK(VOLUME,5))',
+    "columns_required": ['low', 'close', 'volume'],
+    "extras_required": [],
+    "requires_sector": False,
+    "universe": ["equity_cn"],
+    "frequency": ["1d"],
+    "decay_horizon": 5,
+    "min_warmup_bars": 241,
+    "notes": "Original report windows; full nested-window coverage is required.",
+}
+
+def compute(panel: dict) -> pd.DataFrame:
+    l = panel["low"]
+    c = panel["close"]
+    v = panel["volume"]
+    pc = c.shift(1)
+    ret = safe_div(c - pc, pc)
+    tmin5 = ts_min(l, 5)
+    a = -1.0 * tmin5 + tmin5.shift(5)
+    long_diff = (ret.rolling(240, min_periods=240).sum() - ret.rolling(20, min_periods=20).sum()) / 220.0
+    return a * rank(long_diff) * ts_rank(v, 5)
