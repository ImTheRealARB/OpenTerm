+    Returns:
+        pd.DataFrame with index = panel["close"].index, columns = panel["close"].columns.
+    """
+    o = panel["open"]
+    v = panel["volume"]
+    left = rank(ts_corr(o, ts_mean(v, 60).rolling(9).sum(), 6))
