--- /dev/null
+++ b/backend/openterm/journal/shadow.py
@@ -0,0 +1,130 @@
+"""The `journal.shadow` job, run inside a job worker (pandas and numpy load here only).
+
+Question it answers: "had I kept the same ENTRIES but used one fixed exit rule, how would I have done, compared with how I really exited?"
+Both sides are replayed through the same backtester on the same daily bars with the same costs, so the only difference between the two
+equity curves is the exit:
+
+- YOU: every round trip held from its real entry day to its real exit day.
+- RULE: the same entries, left on a fixed holding period, or on a fixed stop and target checked on daily closes.
+
+Simplifications, all printed in the result's labels: positions are equal-weight (your real sizes are not replayed), a trade is entered
+at the open of its entry day, intraday round trips become one daily bar, and a stop or target is only seen at a daily close.
+The result is a HISTORICAL SIMULATION, NOT A FORECAST.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from pathlib import Path
+
+import msgpack
+
+from ..bt.job import HEADLINE, _epoch, scalar_metrics, tail_risk
+
+SHOW_METRICS = ("total_return", "annual_return", "max_drawdown", "sharpe", "trade_count", "win_rate", "profit_loss_ratio")
+
+
+def _bars(df, day: str, side: str) -> int:
+    return int(df.index.searchsorted(day, side=side))
+
+
+def _sets(df, trips: list[dict], rule: dict | None):
+    """(you signal, rule signal, used, skipped) for one symbol's trips on its daily frame."""
+    import numpy as np
+
+    n = len(df)
+    opens, closes = df["open"].to_numpy(float), df["close"].to_numpy(float)
+    you = np.zeros(n + 1)
+    alt = np.zeros(n + 1)
+    used = skipped = 0
+    why: dict[str, int] = {}
+    for t in trips:
+        if t["entry"] < str(df.index[0].date()):
+            why["ENTRY BEFORE THE FIRST BAR"] = why.get("ENTRY BEFORE THE FIRST BAR", 0) + 1
+            continue
+        e = _bars(df, t["entry"], "left")
+        if e >= n:
+            why["ENTRY AFTER THE LAST BAR"] = why.get("ENTRY AFTER THE LAST BAR", 0) + 1
+            continue
+        lo = max(e - 1, 0)  # a signal acts on the next bar, so it starts the bar before the entry day
+        x = min(max(_bars(df, t["exit"], "left"), e, lo + 1), n - 1)
+        d = t["dir"]
+        you[lo] += d
+        you[x] -= d
+        used += 1
+        if rule["kind"] == "hold":
+            xr = min(e + rule["hold_days"], n - 1)
+        else:
+            end = min(e + rule["max_days"], n - 1)
+            ref = opens[e] if opens[e] > 0 else closes[e]
+            move = (closes[e:end + 1] / ref - 1.0) * d * 100.0
+            hit = (move <= -rule["stop_pct"]) | (move >= rule["target_pct"])
+            xr = e + int(np.argmax(hit)) if hit.any() else end
+        alt[lo] += d
+        alt[max(xr, lo + 1)] -= d
+    skipped = len(trips) - used
+    return np.clip(np.cumsum(you[:n]), -1, 1), np.clip(np.cumsum(alt[:n]), -1, 1), used, skipped, why
+
+
+def run(params: dict, progress: Callable[[float, str], None]) -> dict:
+    import pandas as pd
+
+    from ..bt import frames
+    from ..bt.engine import backtest
+
+    progress(0.05, "LOADING DATA")
+    payload = msgpack.unpackb(Path(params["data_path"]).read_bytes(), raw=False)
+    raw = {s: frames.from_bars(b) for s, b in payload["bars"].items()}
+    adjusted = all("adj_close" in f.columns and f["adj_close"].notna().any() for f in raw.values())
+    data = {s: frames.adjusted(f) if adjusted else f for s, f in raw.items()}
+    rule = params["rule"]
+    by_sym: dict[str, list[dict]] = {}
+    for t in params["trips"]:
+        by_sym.setdefault(t["symbol"], []).append(t)
+
+    progress(0.2, "BUILDING SIGNALS")
+    you, alt, used, skipped, why = {}, {}, 0, 0, {}
+    for s, df in data.items():
+        if len(df) < 2:
+            skipped += len(by_sym.get(s, []))
+            why["NOT ENOUGH BARS"] = why.get("NOT ENOUGH BARS", 0) + len(by_sym.get(s, []))
+            continue
+        a, b, u, k, w = _sets(df, by_sym.get(s, []), rule)
+        if u:
+            you[s], alt[s] = pd.Series(a, index=df.index), pd.Series(b, index=df.index)
+        used, skipped = used + u, skipped + k
+        for r, c in w.items():
+            why[r] = why.get(r, 0) + c
+    if not you:
+        raise ValueError("NO TRADE COULD BE REPLAYED: " + ", ".join(f"{k} x{v}" for k, v in why.items()))
+    dm = {s: data[s] for s in you}
+    cfg = dict(params["config"])
+    progress(0.4, "REPLAYING YOUR EXITS")
+    r_you = backtest(dm, you, cfg, engine=params["engine"], bars_per_year=params["bars_per_year"])
+    progress(0.7, "REPLAYING THE RULE")
+    r_alt = backtest(dm, alt, cfg, engine=params["engine"], bars_per_year=params["bars_per_year"])
+    progress(0.95, "WRITING RESULT")
+
+    def curve(res) -> list[list[float]]:
+        return [[_epoch(ts), round(float(v), 4)] for ts, v in res.equity.items()]
+
+    def mets(res) -> dict:
+        m = {**scalar_metrics(res.metrics), **tail_risk(res.equity)}
+        return {k: m.get(k) for k in (*SHOW_METRICS, "var_95", "es_95")}
+
+    cum, real = 0.0, []
+    for t in sorted((t for t in params["trips"] if t["symbol"] in dm), key=lambda t: t["exit"]):
+        cum += t["pnl"]
+        real.append([int(pd.Timestamp(t["exit"]).timestamp()), round(cum, 2)])
+    labels = {**params["labels"], "prices": "ADJ" if adjusted else "RAW", "rule": rule["text"],
+              "notes": ["EQUAL-WEIGHT POSITIONS: YOUR REAL SIZES ARE NOT REPLAYED",
+                        "ENTRIES AT THE OPEN OF YOUR ENTRY DAY; INTRADAY ROUND TRIPS BECOME ONE DAILY BAR",
+                        "A STOP OR TARGET IS ONLY SEEN AT A DAILY CLOSE",
+                        "BOTH CURVES USE THE SAME BARS AND THE SAME COSTS"]}
+    return {
+        "labels": labels, "currency": params["currency"], "rule": rule, "engine": params["engine"],
+        "you": {"equity": curve(r_you), "metrics": mets(r_you)}, "alt": {"equity": curve(r_alt), "metrics": mets(r_alt)},
+        "journal_pnl": {"curve": real, "total": cum, "currency": params["currency"]},
+        "replayed": used, "skipped_trips": skipped, "skipped_reasons": why, "skipped_symbols": params.get("skipped", []),
+        "symbols": sorted(dm), "headline": HEADLINE,
+    }
diff --git a/backend/openterm/journal/store.py b/backend/openterm/journal/store.py
new file mode 100644
index 0000000..edc5026
--- /dev/null
+++ b/backend/openterm/journal/store.py
@@ -0,0 +1,94 @@
+"""SQLite store for the journal (tables `journal_trades`, `journal_imports`; migration 17) and the analysis built from it."""
+
+from __future__ import annotations
+
+import time
+
+import aiosqlite
+
+from . import diagnostics, roundtrips
+from .parsers import Trade
+
+COLS = "id, ts, time, symbol, side, qty, price, fee, currency, broker, order_id, trade_id, mult, import_id"
+MAX_TRIPS_SHOWN = 5000
+MAX_FILLS_SHOWN = 20000
+
+
+class JournalStore:
+    def __init__(self, db: aiosqlite.Connection):
+        self.db = db
+
+    async def add(self, trades: list[Trade], broker: str, name: str, ignored: int) -> dict:
+        """Stores new fills; a fill already stored (same de-duplication key) is skipped and counted."""
+        cur = await self.db.execute(
+            "INSERT INTO journal_imports (at, broker, name, rows, added, duplicates, ignored) VALUES (?,?,?,?,0,0,?)",
+            (time.time(), broker, name[:120], len(trades), ignored))
+        import_id = cur.lastrowid
+        before = self.db.total_changes
+        await self.db.executemany(
+            "INSERT OR IGNORE INTO journal_trades (dkey, ts, time, symbol, side, qty, price, fee, currency, broker, order_id, trade_id, mult, import_id)"
+            " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
+            [(t.dkey, t.ts, t.time, t.symbol, t.side, t.qty, t.price, t.fee, t.currency, t.broker, t.order_id, t.trade_id, t.mult, import_id)
+             for t in trades])
+        added = self.db.total_changes - before
+        await self.db.execute("UPDATE journal_imports SET added=?, duplicates=? WHERE id=?", (added, len(trades) - added, import_id))
+        await self.db.commit()
+        return {"import_id": import_id, "broker": broker, "rows": len(trades), "added": added, "duplicates": len(trades) - added, "ignored": ignored}
+
+    async def fills(self, currency: str | None = None, symbol: str | None = None) -> list[dict]:
+        sql, args = f"SELECT {COLS} FROM journal_trades", []
+        where = []
+        if currency:
+            where.append("currency=?")
+            args.append(currency)
+        if symbol:
+            where.append("symbol=?")
+            args.append(symbol)
+        if where:
+            sql += " WHERE " + " AND ".join(where)
+        sql += " ORDER BY ts, id"
+        async with self.db.execute(sql, args) as cur:
+            names = [d[0] for d in cur.description]
+            return [dict(zip(names, r, strict=True)) async for r in cur]
+
+    async def summary(self) -> dict:
+        async with self.db.execute("SELECT broker, currency, COUNT(*), MIN(time), MAX(time) FROM journal_trades GROUP BY broker, currency") as cur:
+            groups = [{"broker": b, "currency": c, "fills": n, "first": lo, "last": hi} async for b, c, n, lo, hi in cur]
+        async with self.db.execute("SELECT id, at, broker, name, rows, added, duplicates, ignored FROM journal_imports ORDER BY id DESC LIMIT 20") as cur:
+            names = [d[0] for d in cur.description]
+            imports = [dict(zip(names, r, strict=True)) async for r in cur]
+        return {"fills": sum(g["fills"] for g in groups), "groups": groups, "imports": imports}
+
+    async def clear(self, broker: str | None = None) -> int:
+        cur = await self.db.execute("DELETE FROM journal_trades" + (" WHERE broker=?" if broker else ""), (broker,) if broker else ())
+        if not broker:
+            await self.db.execute("DELETE FROM journal_imports")
+        await self.db.commit()
+        return cur.rowcount
+
+    async def analysis(self, currency: str | None = None) -> dict:
+        fills = await self.fills()
+        if not fills:
+            return {"empty": True, "currencies": [], "currency": None}
+        trips, positions = roundtrips.match(fills)
+        n_fills: dict[str, int] = {}
+        n_trips: dict[str, int] = {}
+        for f in fills:
+            n_fills[f["currency"]] = n_fills.get(f["currency"], 0) + 1
+        for t in trips:
+            n_trips[t["currency"]] = n_trips.get(t["currency"], 0) + 1
+        currencies = sorted(n_fills, key=lambda c: (-n_trips.get(c, 0), -n_fills[c], c))
+        if currency and currency not in n_fills:
+            raise KeyError(currency)
+        cur = currency or currencies[0]
+        mine = [t for t in trips if t["currency"] == cur]
+        shown = mine[-MAX_TRIPS_SHOWN:]
+        return roundtrips.clean({
+            "empty": False, "currency": cur,
+            "currencies": [{"currency": c, "fills": n_fills[c], "round_trips": n_trips.get(c, 0)} for c in currencies],
+            "stats": roundtrips.stats(mine), "round_trips": shown, "round_trips_total": len(mine),
+            "open_positions": [p for p in positions if p["currency"] == cur],
+            "diagnostics": diagnostics.diagnose(mine, cur),
+            "labels": {"note": "FIFO ROUND TRIPS FROM YOUR FILLS, NET OF FEES IN THE FILE. NO CURRENCY IS CONVERTED. OPEN POSITIONS ARE NOT MARKED TO ANY PRICE.",
+                       "times": "TIMES ARE THE BROKER FILE'S OWN CLOCK"},
+        })
diff --git a/backend/openterm/journal_routes.py b/backend/openterm/journal_routes.py
new file mode 100644
index 0000000..9ece2dd
--- /dev/null
+++ b/backend/openterm/journal_routes.py
@@ -0,0 +1,186 @@
+"""JRNL routes (`/api/journal/*`): import a broker file, list fills, the analysis (round trips, stats, diagnostics) and the Shadow Account job.
+
+The server parses and matches in plain Python; the Shadow Account fetches daily bars here, writes them to a content-addressed data file and
+submits an internal `journal.shadow` job, so pandas and the backtester load in a worker, never in the request thread (as BT and the quant jobs do).
+"""
+
+import asyncio
+import statistics
+from datetime import date
+
+from fastapi import APIRouter, Query, Request
+
+from .api import bt_of
+from .barfetch import fetch_bars
+from .bt import catalog
+from .errors import DataError
+from .http_util import error, jobs_of, json_object, svc, user
+from .jobs.kinds import BadParams
+from .journal import roundtrips
+from .journal.parsers import BROKERS, JournalError, inspect, parse
+from .journal.store import MAX_FILLS_SHOWN, JournalStore
+from .responses import Orjson, OrjsonRoute
+from .symbols import resolve
+from .userdata import UserDataError
+
+router = APIRouter(prefix="/api/journal", route_class=OrjsonRoute)
+HEADLINE = "HISTORICAL SIMULATION, NOT A FORECAST"
+MIN_TRIPS = 5
+RULES = ("hold", "stop_target")
+
+
+def store_of(request: Request) -> JournalStore:
+    return JournalStore(user(request).db)
+
+
+def bad(msg: str, detail: str | None = None) -> Orjson:
+    return Orjson({"error": msg, "kind": "bad_request", **({"detail": detail} if detail else {})}, status_code=400)
+
+
+async def _text_body(request: Request) -> tuple[dict, str]:
+    body = await json_object(request)
+    text = body.get("text")
+    if not isinstance(text, str) or not text.strip():
+        raise UserDataError("bad_request", "BODY NEEDS text: THE FILE'S CONTENT")
+    return body, text
+
+
+@router.post("/preview")
+async def journal_preview(request: Request):
+    """What a file looks like: the broker it is detected as, its columns and a guessed mapping (the generic mapping step)."""
+    try:
+        _, text = await _text_body(request)
+        return inspect(text)
+    except JournalError as e:
+        return bad(str(e), e.detail)
+    except UserDataError as e:
+        return error(e)
+
+
+@router.post("/import")
+async def journal_import(request: Request):
+    try:
+        body, text = await _text_body(request)
+        mapping = body.get("mapping")
+        if mapping is not None and not isinstance(mapping, dict):
+            raise UserDataError("bad_request", "MAPPING MUST BE AN OBJECT {field: column}")
+        broker, trades, ignored = parse(text, str(body.get("broker") or "auto").lower(), mapping, body.get("date_order"),
+                                        str(body.get("currency") or "USD"))
+    except JournalError as e:
+        return bad(str(e), e.detail)
+    except UserDataError as e:
+        return error(e)
+    out = await store_of(request).add(trades, broker, str(body.get("name") or f"pasted {broker}"), ignored)
+    return {**out, "first": min(t.time for t in trades), "last": max(t.time for t in trades)}
+
+
+@router.get("/summary")
+async def journal_summary(request: Request):
+    return {**await store_of(request).summary(), "brokers": list(BROKERS)}
+
+
+@router.get("/trades")
+async def journal_trades(request: Request, currency: str | None = Query(None, max_length=3), symbol: str | None = Query(None, max_length=32)):
+    fills = await store_of(request).fills(currency.upper() if currency else None, symbol.upper() if symbol else None)
+    return {"fills": fills[-MAX_FILLS_SHOWN:], "total": len(fills), "truncated": len(fills) > MAX_FILLS_SHOWN}
+
+
+@router.get("/analysis")
+async def journal_analysis(request: Request, currency: str | None = Query(None, max_length=3)):
+    try:
+        return await store_of(request).analysis(currency.upper() if currency else None)
+    except KeyError:
+        return bad(f"NO TRADES IN {currency.upper() if currency else ''}")
+
+
+@router.delete("/trades")
+async def journal_clear(request: Request, broker: str | None = Query(None, max_length=16)):
+    return {"deleted": await store_of(request).clear(broker.lower() if broker else None)}
+
+
+# --- Shadow Account -----------------------------------------------------------------------------------------------------------------------
+def _covering_range(first: date) -> str:
+    days = (date.today() - first).days + 45
+    for r, n in (("1Y", 366), ("2Y", 731), ("3Y", 1096), ("5Y", 1827), ("10Y", 3653), ("20Y", 7305)):
+        if days <= n:
+            return r
+    return "MAX"
+
+
+def _num(body: dict, key: str, lo: float, hi: float, default):
+    v = body.get(key)
+    if v is None or v == "":
+        return default
+    if isinstance(v, bool) or not isinstance(v, int | float) or not lo <= v <= hi:
+        raise UserDataError("bad_request", f"{key.upper()} MUST BE A NUMBER {lo:g}-{hi:g}")
+    return float(v)
+
+
+def shadow_rule(body: dict, trips: list[dict]) -> dict:
+    """The rule to replay. Its numbers come from the user's own trips unless typed: hold = the median holding time in days (at least 1),
+    stop = the median loss in percent, target = twice the stop."""
+    kind = str(body.get("rule") or "hold").lower()
+    if kind not in RULES:
+        raise UserDataError("bad_request", f"RULE MUST BE {' OR '.join(RULES)}")
+    med_days = statistics.median(t["hold_s"] for t in trips) / 86400
+    losses = [abs(t["pnl_pct"]) * 100 for t in trips if t["pnl"] < 0]
+    stop_auto = min(30.0, max(0.5, round(statistics.median(losses), 1))) if losses else 2.0
+    hold = _num(body, "hold_days", 1, 250, max(1, round(med_days)))
+    stop = _num(body, "stop_pct", 0.1, 50, stop_auto)
+    target = _num(body, "target_pct", 0.1, 200, round(2 * stop, 1))
+    if kind == "hold":
+        return {"kind": "hold", "hold_days": int(hold), "text": f"HOLD EVERY ENTRY {int(hold)} TRADING DAYS"}
+    return {"kind": "stop_target", "stop_pct": stop, "target_pct": target, "max_days": 60,
+            "text": f"STOP {stop:g}% (YOUR MEDIAN LOSS UNLESS TYPED), TARGET {target:g}%, AT MOST 60 DAYS; CHECKED ON DAILY CLOSES"}
+
+
+@router.post("/shadow")
+async def journal_shadow(request: Request):
+    try:
+        body = await json_object(request)
+        fills = await store_of(request).fills()
+        trips, _ = roundtrips.match(fills)
+        n_by: dict[str, int] = {}
+        for t in trips:
+            n_by[t["currency"]] = n_by.get(t["currency"], 0) + 1
+        cur = str(body.get("currency") or "").upper() or max(n_by, key=lambda c: (n_by[c], c), default="")
+        mine = [t for t in trips if t["currency"] == cur]
+        if len(mine) < MIN_TRIPS:
+            raise UserDataError("bad_request", f"NOT RUNNABLE: {len(mine)} ROUND TRIPS{' IN ' + cur if cur else ''}, NEED {MIN_TRIPS}. IMPORT MORE TRADES")
+        rule = shadow_rule(body, mine)
+        fees = _num(body, "fees_bps", 0, 1000, 0.0)
+        max_syms = int(_num(body, "max_symbols", 1, 12, 8))
+        count: dict[str, int] = {}
+        for t in mine:
+            count[t["symbol"]] = count.get(t["symbol"], 0) + 1
+        picked = sorted(count, key=lambda s: (-count[s], s))[:max_syms]
+        rows = [t for t in mine if t["symbol"] in picked]
+        first = date.fromisoformat(min(t["entry_time"][:10] for t in rows))
+        range_ = _covering_range(first)
+        sym_of = {s: resolve(s) for s in picked}
+        envs, errs = await fetch_bars(svc(request), sorted(set(sym_of.values())), range_, tolerate=True)
+        skipped = [{"symbol": s, "why": str(errs[sym_of[s]]).upper()[:160]} for s in picked if sym_of[s] in errs]
+        have = {s: sym_of[s] for s in picked if sym_of[s] in envs}
+        if not have:
+            raise DataError("unavailable", "NO DAILY BARS FOR ANY OF YOUR SYMBOLS: " + "; ".join(f"{k['symbol']}: {k['why']}" for k in skipped))
+        engine = catalog.engine_for(sorted(have.values()))
+        if engine not in catalog.BUILT or engine == "options":
+            raise UserDataError("bad_request", f"ENGINE {engine.upper()} CANNOT RUN THE SHADOW ACCOUNT")
+        payload = {"bars": {have[s]: envs[have[s]]["data"] for s in have}}
+        sha, path = await asyncio.to_thread(bt_of(request).write_data, payload)
+        trip_rows = [{"symbol": have[t["symbol"]], "entry": t["entry_time"][:10], "exit": t["exit_time"][:10],
+                      "dir": 1 if t["side"] == "long" else -1, "pnl": t["pnl"]} for t in rows if t["symbol"] in have]
+        params = {
+            "data_path": str(path), "data_sha": sha, "trips": trip_rows, "rule": rule, "engine": engine, "currency": cur,
+            "config": {"initial_cash": 100_000.0, **({"fees_bps": fees} if fees else {})}, "bars_per_year": 365 if engine == "crypto" else 252,
