+import { describe, expect, it } from "vitest";
+import type { SyncRecord } from "../net/syncApi";
+import { FUNCTIONS } from "./registry";
+import { ageText, countsLine, diffLines, headline, noDifference, parseSyncArgs, STALE_AFTER_S } from "./syncModel";
+
+// Records below are TEST DATA written for these tests (NOT a recording of any broker).
+const rec = (over: Partial<SyncRecord> = {}): SyncRecord => ({
+  broker: "kite", portfolio: "KITE", at: 1_000_000, ok: true, error: null, base: "INR",
+  counts: { fetched: 5, imported: 4, skipped: 1, conflicts: 0, manual_kept: 2, previous: 3 },
+  diff: { added: ["TCS.NS"], removed: ["OLD.NS"], changed: [{ symbol: "INFY.NS", qty_from: 10, qty_to: 4, cost_from: 1400.5, cost_to: 1400.5 }] },
+  skipped: [], conflicts: [], warnings: [], holdings: 4, positions: 0, ...over,
+});
+
+describe("SYNC registry entry", () => {
+  it("is registered, lazy, and takes no security", () => {
+    const f = FUNCTIONS.get("SYNC");
+    expect(f?.load).toBeTypeOf("function");
+    expect(f?.needsSecurity).toBe(false);
+  });
+});
+
+describe("parseSyncArgs", () => {
+  it("reads broker, portfolio and flags in any order", () => {
+    expect(parseSyncArgs(["kite", "main", "pos", "go"])).toEqual({ broker: "kite", portfolio: "MAIN", positions: true, account: null, go: true });
+    expect(parseSyncArgs(["IBKR", "acct=U1234567"])).toMatchObject({ broker: "ibkr", account: "U1234567", go: false });
+    expect(parseSyncArgs([])).toMatchObject({ broker: null, portfolio: null });
+  });
+  it("refuses what cannot work", () => {
+    expect(parseSyncArgs(["go"])).toHaveProperty("error");
+    expect(parseSyncArgs(["kite", "ibkr"])).toHaveProperty("error");
+    expect(parseSyncArgs(["ibkr", "pos"])).toHaveProperty("error");
+    expect(parseSyncArgs(["kite", "acct=U1234567"])).toHaveProperty("error");
+    expect(parseSyncArgs(["kite", "bad name!"])).toHaveProperty("error");
+    expect(parseSyncArgs(["ibkr", "acct=x"])).toHaveProperty("error");
+  });
+});
+
+describe("ageText", () => {
+  it("rounds down to the largest unit", () => {
+    expect(ageText(100, 130)).toBe("JUST NOW");
+    expect(ageText(0, 300)).toBe("5M AGO");
+    expect(ageText(0, 7300)).toBe("2H AGO");
+    expect(ageText(0, 3 * 86400 + 5)).toBe("3D AGO");
+  });
+});
+
+describe("diff and counts lines", () => {
+  it("lists added, removed and changed symbols", () => {
+    expect(diffLines(rec().diff)).toEqual(["+ TCS.NS", "- OLD.NS", "~ INFY.NS 10 -> 4"]);
+    expect(diffLines({ added: [], removed: [], changed: [{ symbol: "A", qty_from: 1, qty_to: 1, cost_from: 5, cost_to: null }] })).toEqual(["~ A 1 -> 1 (COST 5 -> -)"]);
+    expect(diffLines(null)).toEqual([]);
+  });
+  it("caps long diffs", () => {
+    const added = Array.from({ length: 40 }, (_, i) => `S${i}`);
+    const lines = diffLines({ added, removed: [], changed: [] }, 30);
+    expect(lines).toHaveLength(31);
+    expect(lines[30]).toBe("… 10 MORE");
+  });
+  it("knows an empty difference", () => {
+    expect(noDifference({ added: [], removed: [], changed: [] })).toBe(true);
+    expect(noDifference(rec().diff)).toBe(false);
+    expect(noDifference(null)).toBe(false);
+  });
+  it("summarises counts per broker", () => {
+    expect(countsLine(rec())).toBe("4 LOTS IMPORTED · 1 SKIPPED · 0 CONFLICTS · 2 MANUAL KEPT · 4 HOLDINGS · 0 POSITIONS");
+    expect(countsLine(rec({ broker: "ibkr", accounts: ["U1", "U2"] }))).toContain("2 ACCOUNTS");
+  });
+});
+
+describe("headline", () => {
+  const ok = rec();
+  it("shows source, portfolio and age for a fresh sync", () => {
+    const h = headline("kite", ok, null, ok.at + 120);
+    expect(h.cls).toBe("up");
+    expect(h.text).toContain("KITE → KITE");
+    expect(h.text).toContain("2M AGO");
+  });
+  it("says STALE after a day", () => {
+    expect(headline("kite", ok, null, ok.at + STALE_AFTER_S + 1)).toMatchObject({ cls: "warn" });
+    expect(headline("kite", ok, null, ok.at + STALE_AFTER_S + 1).text.startsWith("STALE")).toBe(true);
+  });
+  it("says ERR when a later try failed, and when it never worked", () => {
+    const bad = rec({ ok: false, at: ok.at + 60, error: "IBKR GATEWAY NOT RUNNING" });
+    expect(headline("kite", ok, bad, ok.at + 120).text.startsWith("ERR")).toBe(true);
+    expect(headline("ibkr", null, bad, ok.at + 120)).toMatchObject({ cls: "err" });
+    expect(headline("ibkr", null, null, 0)).toEqual({ text: "IBKR NEVER SYNCED", cls: "dim" });
+  });
+});
diff --git a/frontend/src/functions/syncModel.ts b/frontend/src/functions/syncModel.ts
new file mode 100644
index 0000000..104e561
--- /dev/null
+++ b/frontend/src/functions/syncModel.ts
@@ -0,0 +1,91 @@
+/** Pure logic of the SYNC panel: the command words, ages and the lines that describe a sync. No React, no network. */
+import type { Broker, SyncDiff, SyncRecord } from "../net/syncApi";
+
+export const SYNC_USAGE = "USAGE: SYNC [KITE|IBKR] [PORTFOLIO] [POS] [ACCT=U1234567] [GO]   (PORT SYNC KITE|IBKR works too)";
+/** A successful sync older than this is shown as STALE: the broker may hold something else by now. */
+export const STALE_AFTER_S = 24 * 3600;
+const NAME_RE = /^[A-Z0-9][A-Z0-9_.-]{0,31}$/;
+
+export interface SyncArgs {
+  broker: Broker | null;
+  portfolio: string | null;
+  positions: boolean;
+  account: string | null;
+  go: boolean;
+}
+
+export function parseSyncArgs(args: string[]): SyncArgs | { error: string } {
+  const out: SyncArgs = { broker: null, portfolio: null, positions: false, account: null, go: false };
+  for (const raw of args) {
+    const w = raw.toUpperCase();
+    if (w === "KITE" || w === "IBKR") {
+      if (out.broker && out.broker !== w.toLowerCase()) return { error: "ONE BROKER AT A TIME: SYNC KITE OR SYNC IBKR" };
+      out.broker = w.toLowerCase() as Broker;
+    } else if (w === "GO") out.go = true;
+    else if (w === "POS" || w === "POSITIONS") out.positions = true;
+    else if (w.startsWith("ACCT=")) {
+      const a = raw.slice(5);
+      if (!/^[A-Za-z0-9]{3,24}$/.test(a)) return { error: "ACCT= TAKES AN IBKR ACCOUNT ID, E.G. ACCT=U1234567" };
+      out.account = a;
+    } else if (NAME_RE.test(w) && !out.portfolio) out.portfolio = w;
+    else return { error: `${raw.slice(0, 24).toUpperCase()}: NOT A BROKER OR PORTFOLIO NAME` };
+  }
+  if (out.go && !out.broker) return { error: "NAME THE BROKER TO RUN: SYNC KITE GO OR SYNC IBKR GO" };
+  if (out.positions && out.broker === "ibkr") return { error: "POS IS FOR KITE (DAY POSITIONS). IBKR ALWAYS SYNCS EVERY POSITION" };
+  if (out.account && out.broker === "kite") return { error: "ACCT= IS FOR IBKR" };
+  return out;
+}
+
+/** "5M AGO", "3H AGO", "2D AGO"; "JUST NOW" under a minute. */
+export function ageText(at: number, now: number): string {
+  const s = Math.max(0, Math.round(now - at));
+  if (s < 60) return "JUST NOW";
+  if (s < 3600) return `${Math.floor(s / 60)}M AGO`;
+  if (s < 86400) return `${Math.floor(s / 3600)}H AGO`;
+  return `${Math.floor(s / 86400)}D AGO`;
+}
+
+export function isStale(rec: SyncRecord | null, now: number): boolean {
+  return !!rec && now - rec.at > STALE_AFTER_S;
+}
+
+export function stamp(at: number): string {
+  const d = new Date(at * 1000);
+  const p = (n: number) => String(n).padStart(2, "0");
+  return `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())}Z`;
+}
+
+export function countsLine(rec: SyncRecord): string {
+  const c = rec.counts;
+  if (!c) return "";
+  const parts = [`${c.imported} LOTS IMPORTED`, `${c.skipped} SKIPPED`, `${c.conflicts} CONFLICTS`, `${c.manual_kept} MANUAL KEPT`];
+  if (rec.broker === "kite" && rec.holdings !== undefined) parts.push(`${rec.holdings} HOLDINGS`, `${rec.positions ?? 0} POSITIONS`);
+  if (rec.broker === "ibkr" && rec.accounts) parts.push(`${rec.accounts.length} ACCOUNTS`);
+  return parts.join(" · ");
+}
+
+const q = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 4 });
+
+/** One line per difference against the previous sync: `+ INFY.NS`, `- TCS.NS`, `~ AAPL 10 -> 4`. */
+export function diffLines(d: SyncDiff | null, limit = 30): string[] {
+  if (!d) return [];
+  const lines = [
+    ...d.added.map((s) => `+ ${s}`),
+    ...d.removed.map((s) => `- ${s}`),
+    ...d.changed.map((c) => `~ ${c.symbol} ${q(c.qty_from)} -> ${q(c.qty_to)}${c.cost_from !== c.cost_to ? ` (COST ${c.cost_from ?? "-"} -> ${c.cost_to ?? "-"})` : ""}`),
+  ];
+  return lines.length > limit ? [...lines.slice(0, limit), `… ${lines.length - limit} MORE`] : lines;
+}
+
+export function noDifference(d: SyncDiff | null): boolean {
+  return !!d && !d.added.length && !d.removed.length && !d.changed.length;
+}
+
+/** The headline of a broker's block: last good sync with its age and source, STALE when old, or the failure. */
+export function headline(broker: Broker, lastOk: SyncRecord | null, lastErr: SyncRecord | null, now: number): { text: string; cls: "up" | "warn" | "err" | "dim" } {
+  const name = broker === "kite" ? "KITE" : "IBKR";
+  if (!lastOk) return { text: lastErr ? `${name} NEVER SYNCED · LAST TRY FAILED ${ageText(lastErr.at, now)}` : `${name} NEVER SYNCED`, cls: lastErr ? "err" : "dim" };
+  const base = `${name} → ${lastOk.portfolio} · SYNCED ${stamp(lastOk.at)} (${ageText(lastOk.at, now)})`;
+  if (lastErr && lastErr.at > lastOk.at) return { text: `ERR ${base} · LATER TRY FAILED ${ageText(lastErr.at, now)}`, cls: "err" };
+  return isStale(lastOk, now) ? { text: `STALE ${base}`, cls: "warn" } : { text: base, cls: "up" };
+}
