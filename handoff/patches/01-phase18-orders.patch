new file mode 100644
index 0000000..55168d0
--- /dev/null
+++ b/backend/openterm/orders/ledger.py
@@ -0,0 +1,40 @@
+"""Every order event goes into the hash-chained audit ledger (ai/audit.py, table `ai_ledger`) as kind `order`.
+
+Entry: ref = our client order id (or the event name for account-level events), model = `<broker>:<mode>`, manifest = {event, app, broker, mode,
+account tail}, meta = the event's facts (order fields, check results, broker order id, error text). Never a key, token or confirm token.
+Error text is redacted. A ledger failure is logged and re-raised only for the events that must not happen unrecorded (see service.submit).
+"""
+
+from __future__ import annotations
+
+import logging
+
+from .. import __version__
+from ..ai.audit import AuditLog
+from ..redact import redact
+
+log = logging.getLogger("openterm.orders.ledger")
+KIND = "order"
+EVENTS = ("confirm_issued", "refused", "submitted", "accepted", "failed", "cancel", "cancel_failed", "replace", "kill_on", "kill_off", "kill_cancel_all",
+          "live_on", "live_off", "mandate_changed", "import_fills")
+
+
+def clean(v):
+    """Strings are redacted and clipped; containers are cleaned recursively."""
+    if isinstance(v, str):
+        return redact(v)[:400]
+    if isinstance(v, dict):
+        return {str(k): clean(x) for k, x in v.items()}
+    if isinstance(v, list | tuple):
+        return [clean(x) for x in v[:100]]
+    return v
+
+
+class OrderLedger:
+    def __init__(self, audit: AuditLog):
+        self.audit = audit
+
+    async def event(self, event: str, broker: str = "-", mode: str = "-", ref: str | None = None, account: str = "", **meta) -> dict:
+        assert event in EVENTS, event
+        mf = {"event": event, "app": __version__, "broker": broker, "mode": mode, "account": ("…" + account[-4:]) if account else ""}
+        return await self.audit.append(KIND, ref or event, f"{broker}:{mode}", mf, clean(meta))
diff --git a/backend/openterm/orders/mandate.py b/backend/openterm/orders/mandate.py
new file mode 100644
index 0000000..6ff0ac1
--- /dev/null
+++ b/backend/openterm/orders/mandate.py
@@ -0,0 +1,88 @@
+"""The mandate: what the user allows orders to do. Pure checks (`check`) plus validation of the stored document.
+
+Zero means zero: a cap of 0 refuses every order, and an empty symbol list allows no symbol. The default mandate therefore allows
+nothing until the user sets it (ORD MANDATE). A check that cannot be computed (no price for a market order, positions unreadable)
+fails: the mandate never passes on missing data.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import asdict, dataclass, field
+
+from .errors import OrderError
+from .model import SYMBOL_RE, Order, number, qty_text
+
+MAX_SYMBOLS = 200
+MAX_VALUE = 1e12
+
+
+@dataclass
+class Mandate:
+    symbols: list[str] = field(default_factory=list)
+    max_shares: float = 100.0
+    max_notional: float = 5000.0
+    max_gross: float = 25000.0
+    max_trades_per_day: int = 10
+
+    def public(self) -> dict:
+        return asdict(self)
+
+
+def parse(raw) -> Mandate:
+    """A validated mandate from a JSON object. Unknown fields are refused."""
+    if not isinstance(raw, dict):
+        raise OrderError("bad_request", "MANDATE MUST BE AN OBJECT")
+    extra = sorted(set(raw) - set(Mandate.__dataclass_fields__))
+    if extra:
+        raise OrderError("bad_request", f"UNKNOWN MANDATE FIELD {', '.join(extra)[:60].upper()}")
+    base = Mandate()
+    syms = raw.get("symbols", base.symbols)
+    if not isinstance(syms, list) or len(syms) > MAX_SYMBOLS or not all(isinstance(s, str) for s in syms):
+        raise OrderError("bad_request", f"symbols MUST BE A LIST OF AT MOST {MAX_SYMBOLS} SYMBOLS")
+    clean: list[str] = []
+    for s in syms:
+        u = s.strip().upper()
+        if not SYMBOL_RE.match(u):
+            raise OrderError("bad_request", f"BAD SYMBOL IN MANDATE: {u[:24]}")
+        if u not in clean:
+            clean.append(u)
+    out = Mandate(symbols=clean)
+    for name in ("max_shares", "max_notional", "max_gross"):
+        v = number(raw.get(name, getattr(base, name)), name)
+        if not 0 <= v <= MAX_VALUE:
+            raise OrderError("bad_request", f"{name} MUST BE 0 TO {MAX_VALUE:g}")
+        setattr(out, name, v)
+    n = number(raw.get("max_trades_per_day", base.max_trades_per_day), "max_trades_per_day", integer=True)
+    if not 0 <= n <= 1000:
+        raise OrderError("bad_request", "max_trades_per_day MUST BE 0 TO 1000")
+    out.max_trades_per_day = int(n)
+    return out
+
+
+def check(order: Order, m: Mandate, price: float | None, gross: float | None, position_qty: float | None, trades_today: int) -> dict:
+    """{ok, checks: [{name, ok, detail}]}. `price` is the reference price (limit, stop or a quote), `gross` the account's current gross
+    exposure, `position_qty` the signed quantity held in this symbol; any of them None fails the check that needs it."""
+    checks: list[dict] = []
+
+    def add(name: str, ok: bool, detail: str) -> None:
+        checks.append({"name": name, "ok": bool(ok), "detail": detail})
+
+    allowed = order.symbol in m.symbols
+    add("SYMBOL ALLOWED", allowed,
+        f"{order.symbol} IS ON THE ALLOWLIST" if allowed else f"{order.symbol} IS NOT ON THE ALLOWLIST ({len(m.symbols)} SYMBOLS)")
+    add("MAX SHARES", order.qty <= m.max_shares, f"{qty_text(order.qty)} OF MAX {m.max_shares:g}")
+    if price is None or not math.isfinite(price) or price <= 0:
+        add("MAX NOTIONAL", False, "NO PRICE TO VALUE THE ORDER (A MARKET ORDER NEEDS A LIVE QUOTE): REFUSED")
+        add("MAX GROSS EXPOSURE", False, "NO PRICE TO VALUE THE ORDER: REFUSED")
+    else:
+        notional = order.qty * price
+        add("MAX NOTIONAL", notional <= m.max_notional, f"{notional:,.2f} OF MAX {m.max_notional:,.2f} (PRICE {price:g})")
+        if gross is None or position_qty is None:
+            add("MAX GROSS EXPOSURE", False, "ACCOUNT POSITIONS COULD NOT BE READ: REFUSED")
+        else:
+            signed = order.qty if order.side == "buy" else -order.qty
+            after = gross - abs(position_qty * price) + abs((position_qty + signed) * price)
+            add("MAX GROSS EXPOSURE", after <= m.max_gross, f"{after:,.2f} AFTER THIS ORDER OF MAX {m.max_gross:,.2f} (NOW {gross:,.2f})")
+    add("DAILY TRADES", trades_today < m.max_trades_per_day, f"{trades_today} SENT TODAY OF MAX {m.max_trades_per_day}")
+    return {"ok": all(c["ok"] for c in checks), "checks": checks}
diff --git a/backend/openterm/orders/model.py b/backend/openterm/orders/model.py
new file mode 100644
index 0000000..0e5d4ec
--- /dev/null
+++ b/backend/openterm/orders/model.py
@@ -0,0 +1,129 @@
+"""The order a user typed, validated. Pure: no network, no database.
+
+`Order.from_body` accepts exactly the fields below. A request can name a broker (`alpaca-paper`, `alpaca-live`, `kite`) but can never
+say "paper" or "live": those words are refused as fields, because the mode comes from the broker account (brokers/*.detect_mode).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import math
+import re
+from dataclasses import dataclass
+
+import orjson
+
+from .errors import OrderError
+
+BROKERS = ("alpaca-paper", "alpaca-live", "kite")
+SIDES = ("buy", "sell")
+TYPES = ("market", "limit", "stop")
+TIFS = ("day", "gtc", "ioc")
+KITE_PRODUCTS = ("CNC", "MIS", "NRML")
+KITE_SUFFIXES = ("NS", "BO", "NFO", "MCX")
+FIELDS = {"broker", "symbol", "side", "qty", "type", "tif", "limit_price", "stop_price", "product"}
+SYMBOL_RE = re.compile(r"^[A-Z0-9][A-Z0-9.\-&]{0,19}\Z")
+MAX_QTY = 1e9
+MAX_PRICE = 1e9
+#: words that would mean "a request sets the mode"; refused with a pointed message instead of the generic unknown-field one
+MODE_WORDS = {"mode", "live", "paper", "account_type", "host", "base_url", "environment", "env", "sandbox", "simulate", "dry_run", "force"}
+
+
+def number(x, what: str, integer: bool = False) -> float:
+    if isinstance(x, bool) or not isinstance(x, int | float) or not math.isfinite(x):
+        raise OrderError("bad_request", f"{what} MUST BE A FINITE NUMBER")
+    if integer and float(x) != int(x):
+        raise OrderError("bad_request", f"{what} MUST BE A WHOLE NUMBER")
+    return float(x)
+
+
+def qty_text(q: float) -> str:
+    """Canonical text of a quantity (no float noise): 10, 0.5, 1.25."""
+    return f"{q:.6f}".rstrip("0").rstrip(".")
+
+
+@dataclass(frozen=True)
+class Order:
+    broker: str
+    symbol: str
+    side: str
+    qty: float
+    type: str
+    tif: str
+    limit_price: float | None = None
+    stop_price: float | None = None
+    product: str | None = None
+
+    @classmethod
+    def from_body(cls, body) -> Order:
+        if not isinstance(body, dict):
+            raise OrderError("bad_request", "ORDER MUST BE AN OBJECT")
+        bad = [k for k in body if k in MODE_WORDS]
+        if bad:
+            raise OrderError("bad_request", "PAPER OR LIVE IS NEVER SET BY A REQUEST: IT COMES FROM THE BROKER ACCOUNT. PICK THE BROKER "
+                                            f"({', '.join(BROKERS)}) AND REMOVE {', '.join(sorted(bad)).upper()}")
+        extra = sorted(set(body) - FIELDS)
+        if extra:
+            raise OrderError("bad_request", f"UNKNOWN ORDER FIELD {', '.join(extra)[:60].upper()}")
+        broker = body.get("broker")
+        if broker not in BROKERS:
+            raise OrderError("bad_request", f"broker MUST BE ONE OF {', '.join(BROKERS)}")
+        sym = body.get("symbol")
+        if not isinstance(sym, str) or not SYMBOL_RE.match(sym.strip().upper()):
+            raise OrderError("bad_request", "symbol MUST BE LETTERS/DIGITS, E.G. AAPL OR RELIANCE.NS")
+        sym = sym.strip().upper()
+        side = body.get("side")
+        if side not in SIDES:
+            raise OrderError("bad_request", "side MUST BE buy OR sell")
+        typ = body.get("type", "market")
+        if typ not in TYPES:
+            raise OrderError("bad_request", "type MUST BE market, limit OR stop")
+        tif = body.get("tif", "day")
+        if tif not in TIFS:
+            raise OrderError("bad_request", "tif MUST BE day, gtc OR ioc")
+        qty = number(body.get("qty"), "qty", integer=broker == "kite")
+        if not 0 < qty <= MAX_QTY:
+            raise OrderError("bad_request", "qty MUST BE ABOVE 0")
+        if round(qty, 6) != qty:
+            raise OrderError("bad_request", "qty HAS AT MOST 6 DECIMALS")
+        limit = stop = None
+        if typ == "limit":
+            limit = number(body.get("limit_price"), "limit_price")
+        elif body.get("limit_price") is not None:
+            raise OrderError("bad_request", "limit_price IS ONLY FOR type limit")
+        if typ == "stop":
+            stop = number(body.get("stop_price"), "stop_price")
+        elif body.get("stop_price") is not None:
+            raise OrderError("bad_request", "stop_price IS ONLY FOR type stop")
+        for name, v in (("limit_price", limit), ("stop_price", stop)):
+            if v is not None and not 0 < v <= MAX_PRICE:
+                raise OrderError("bad_request", f"{name} MUST BE ABOVE 0")
+        product = body.get("product")
+        if broker == "kite":
+            if tif == "gtc":
+                raise OrderError("bad_request", "KITE HAS NO GTC: USE day OR ioc")
+            if "." not in sym or sym.rsplit(".", 1)[-1] not in KITE_SUFFIXES:
+                raise OrderError("bad_request", "KITE SYMBOL NEEDS A SUFFIX: RELIANCE.NS, TCS.BO, <X>.NFO OR <X>.MCX")
+            if product is not None and product not in KITE_PRODUCTS:
+                raise OrderError("bad_request", f"product MUST BE ONE OF {', '.join(KITE_PRODUCTS)}")
+        elif product is not None:
+            raise OrderError("bad_request", "product IS ONLY FOR kite")
+        return cls(broker, sym, side, qty, typ, tif, limit, stop, product)
+
+    def ref_price(self) -> float | None:
+        """The price the order itself names (limit, else stop); None for a market order, whose price must come from a quote."""
+        return self.limit_price if self.limit_price is not None else self.stop_price
+
+    def public(self) -> dict:
+        return {"broker": self.broker, "symbol": self.symbol, "side": self.side, "qty": self.qty, "type": self.type, "tif": self.tif,
+                "limit_price": self.limit_price, "stop_price": self.stop_price, "product": self.product}
+
+    def line(self) -> str:
+        px = f" @ {self.limit_price:g}" if self.limit_price is not None else f" STOP {self.stop_price:g}" if self.stop_price is not None else ""
+        return f"{self.side.upper()} {qty_text(self.qty)} {self.symbol} {self.type.upper()}{px} {self.tif.upper()}"
+
+
+def fingerprint(order: Order, mode: str, account: str) -> str:
+    """What a confirm token is bound to: the whole order plus the mode and account the broker reported."""
+    d = {**order.public(), "qty": qty_text(order.qty), "mode": mode, "account": account}
+    return hashlib.sha256(orjson.dumps(d, option=orjson.OPT_SORT_KEYS)).hexdigest()
diff --git a/backend/openterm/orders/routes.py b/backend/openterm/orders/routes.py
new file mode 100644
index 0000000..ddf5d57
--- /dev/null
+++ b/backend/openterm/orders/routes.py
@@ -0,0 +1,158 @@
+"""Order routes, all under /api/orders and ALL loopback-only (account data and money). Not in the AI tool registry or the MCP server;
+tests scan both for these paths.
+
+No route takes a `mode`, `live` or `paper` field: the order body is parsed by `Order.from_body`, which refuses those words.
+"""
+
+from __future__ import annotations
+
+from fastapi import APIRouter, Request
+
+from ..http_util import json_object, loopback
+from ..redact import redact
+from ..responses import Orjson, OrjsonRoute
+from ..userdata import UserDataError
+from .errors import STATUS, OrderError
+
+router = APIRouter(prefix="/api/orders", route_class=OrjsonRoute)
+
+
+def service_of(request: Request):
+    """Built on first use. A new database (tests reuse the app object) gets a new service."""
+    from ..ai.audit import audit_of
+    from ..http_util import svc, user
+    from .brokers.alpaca import AlpacaTrading
+    from .brokers.kite import KiteTrading
+    from .ledger import OrderLedger
+    from .service import OrderService
+
+    app = request.app
+    db = user(request).db
+    cur = getattr(app.state, "orders", None)
+    if cur is None or cur.db is not db:
+        store, http, service = app.state.keys, app.state.keys_http, svc(request)
+
+        async def price_of(symbol: str):
+            """Last price from the quote service. A stale or missing quote gives None, which the mandate treats as a refusal."""
+            try:
+                env = (await service.quotes([symbol])).get(symbol) or {}
+            except Exception:  # noqa: BLE001 - any quote failure is "no price"
+                return None, "QUOTE FAILED"
+            data = env.get("data") if isinstance(env, dict) else None
+            price = data.get("price") if isinstance(data, dict) else None
+            if not isinstance(price, int | float) or env.get("stale"):
+                return None, "NO FRESH QUOTE"
+            return float(price), f"{env.get('source') or 'quote'} {env.get('age_s', 0):g}s OLD"
+
+        brokers = {b.id: b for b in (AlpacaTrading("paper", store, http), AlpacaTrading("live", store, http), KiteTrading(app.state.kite))}
+        app.state.orders = OrderService(db, OrderLedger(audit_of(app, db)), brokers, price_of)
+    return app.state.orders
+
+
+def fail(e: OrderError) -> Orjson:
+    body = {"error": redact(str(e)), "kind": e.kind}
+    if e.detail:
+        body["detail"] = e.detail
+    if e.kind == "key_required":
+        body["key"] = redact(str(e)).split("set ", 1)[-1].split(" in ")[0]
+    return Orjson(body, status_code=STATUS.get(e.kind, 500))
+
+
+def forbidden() -> Orjson:
+    return Orjson({"error": "ORDERS CAN ONLY BE USED FROM THIS MACHINE", "kind": "forbidden"}, status_code=403)
+
+
+async def body_of(request: Request) -> dict:
+    try:
+        return await json_object(request)
+    except UserDataError as e:
+        raise OrderError("bad_request", str(e)) from e
+
+
+def guarded(fn):
+    """Loopback check, OrderError -> error answer."""
+    import functools
+
+    @functools.wraps(fn)
+    async def wrapper(request: Request, *a, **kw):
+        if not loopback(request):
+            return forbidden()
+        try:
+            return await fn(request, *a, **kw)
+        except OrderError as e:
+            return fail(e)
+
+    return wrapper
+
+
+@router.get("/status")
+@guarded
+async def status(request: Request):
+    return await service_of(request).status()
+
+
+@router.get("/blotter")
+@guarded
+async def blotter(request: Request, broker: str = ""):
+    return await service_of(request).blotter(broker)
+
+
+@router.post("/preview")
+@guarded
+async def preview(request: Request):
+    body = await body_of(request)
+    if set(body) - {"order", "replace"}:
+        raise OrderError("bad_request", "BODY NEEDS order (AND OPTIONALLY replace)")
+    return await service_of(request).preview(body.get("order"), body.get("replace"))
+
+
+@router.post("/submit")
+@guarded
+async def submit(request: Request):
+    body = await body_of(request)
+    if set(body) - {"order", "token", "replace"}:
+        raise OrderError("bad_request", "BODY NEEDS order, token (AND OPTIONALLY replace)")
+    return await service_of(request).submit(body.get("order"), body.get("token"), body.get("replace"))
+
+
+@router.post("/cancel")
+@guarded
+async def cancel(request: Request):
+    body = await body_of(request)
+    return await service_of(request).cancel(body.get("broker"), body.get("order_id"))
+
+
+@router.post("/kill")
+@guarded
+async def kill(request: Request):
+    return await service_of(request).kill()
+
+
+@router.post("/unkill")
+@guarded
+async def unkill(request: Request):
+    return await service_of(request).unkill()
+
+
+@router.put("/mandate")
+@guarded
+async def put_mandate(request: Request):
+    return await service_of(request).set_mandate(await body_of(request))
+
+
+@router.put("/live")
+@guarded
+async def put_live(request: Request):
+    body = await body_of(request)
+    if not isinstance(body.get("on"), bool):
+        raise OrderError("bad_request", "BODY NEEDS on (true OR false)")
+    return await service_of(request).set_live(body["on"], body.get("phrase"))
+
+
+@router.post("/import")
+@guarded
+async def import_fills(request: Request):
+    body = await body_of(request)
+    if not isinstance(body.get("portfolio"), str) or not body["portfolio"].strip():
+        raise OrderError("bad_request", "BODY NEEDS portfolio (A NAME)")
+    return await service_of(request).import_fills(body.get("broker"), body["portfolio"].strip())
diff --git a/backend/openterm/orders/service.py b/backend/openterm/orders/service.py
new file mode 100644
index 0000000..7c1237e
--- /dev/null
+++ b/backend/openterm/orders/service.py
@@ -0,0 +1,258 @@
+"""OrderService: the only way an order reaches a broker.
+
+submit() order of checks (each one a refusal that is written to the ledger):
+  1. kill switch off            2. keys / login present        3. account read from the broker: mode from its host and account
+  4. live switched on by the user (live only)                   5. mandate passes (allowlist, size, notional, gross exposure, daily cap)
+  6. a fresh one-time confirm token issued for exactly this order, mode and account
+then `submitted` is written to the ledger BEFORE the broker is called, and `accepted` or `failed` after.
+A lock serialises preview-to-send, so two orders cannot both pass the daily cap, and the kill switch is read again inside it.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+import uuid
+
+from ..portfolio import Portfolios
+from ..redact import redact
+from ..userdata import UserDataError
+from . import mandate as mandate_mod
+from .brokers.base import Broker
+from .confirm import ConfirmTokens
+from .errors import OrderError
+from .ledger import OrderLedger
+from .model import Order, fingerprint
+from .store import OrdersStore
+
+log = logging.getLogger("openterm.orders")
+LIVE_PHRASE = "I UNDERSTAND LIVE ORDERS USE REAL MONEY"
+EXPECTED_MODE = {"alpaca-paper": "paper", "alpaca-live": "live", "kite": "live"}
+
+
+class OrderService:
+    def __init__(self, db, ledger: OrderLedger, brokers: dict[str, Broker], price_fn, tokens: ConfirmTokens | None = None):
+        self.store = OrdersStore(db)
+        self.db = db
+        self.ledger = ledger
+        self.brokers = brokers
+        self.price_fn = price_fn  # async (symbol) -> (price | None, note)
+        self.tokens = tokens or ConfirmTokens()
+        self.lock = asyncio.Lock()
+
+    # --- lookups ---
+    def broker(self, broker_id: str) -> Broker:
+        b = self.brokers.get(broker_id)
+        if b is None:
+            raise OrderError("bad_request", f"UNKNOWN BROKER {str(broker_id)[:24]}")
+        return b
+
+    async def _ready_account(self, b: Broker) -> dict:
+        """The broker's account, with `mode` verified against what this broker id must be."""
+        err = b.not_ready()
+        if err:
+            raise err
+        acct = await b.account()
+        if acct["mode"] != EXPECTED_MODE.get(b.id):
+            raise OrderError("mode_mismatch", f"{b.id} REPORTED A {acct['mode'].upper()} ACCOUNT: ORDERS REFUSED")
+        return acct
+
+    # --- status ---
+    async def status(self) -> dict:
+        kill = await self.store.kill()
+        return {"kill": {"on": bool(kill.get("on")), "at": kill.get("at")}, "live_enabled": await self.store.live_enabled(),
+                "mandate": (await self.store.mandate()).public(), "trades_today": await self.store.trades_today(),
+                "brokers": [self._broker_row(b) for b in self.brokers.values()]}
+
+    @staticmethod
+    def _broker_row(b: Broker) -> dict:
+        err = b.not_ready()
+        return {"id": b.id, "label": b.label, "slot_mode": EXPECTED_MODE.get(b.id), "ready": err is None,
+                "message": str(err) if err else None, "kind": err.kind if err else None, "note": b.note}
+
+    async def blotter(self, broker_id: str) -> dict:
+        """Account, open orders, today's fills and positions. A part that fails is named in `errors`; the others still show."""
+        b = self.broker(broker_id)
+        acct = await self._ready_account(b)
+        parts = await asyncio.gather(b.open_orders(), b.fills_today(), b.positions(), return_exceptions=True)
+        out: dict = {"broker": b.id, "account": acct, "as_of": time.time(), "errors": {}}
+        for name, got in zip(("open_orders", "fills", "positions"), parts, strict=True):
+            if isinstance(got, OrderError):
+                out["errors"][name] = str(got)
+                out[name] = None
+            elif isinstance(got, BaseException):
+                out["errors"][name] = f"{b.label.upper()} {name.upper()} FAILED ({type(got).__name__})"
+                out[name] = None
+            else:
+                out[name] = got
+        return out
+
+    # --- the gate shared by preview and submit ---
+    async def _gate(self, order: Order, replace: str | None) -> dict:
+        kill = await self.store.kill()
+        if kill.get("on"):
+            raise OrderError("kill_switch", "KILL SWITCH IS ON: NO NEW ORDERS UNTIL ORD UNKILL")
+        b = self.broker(order.broker)
+        acct = await self._ready_account(b)
+        mode = acct["mode"]
+        if mode == "live" and not await self.store.live_enabled():
+            raise OrderError("live_off", "LIVE ORDERS ARE OFF. TYPE ORD LIVE ON TO ENABLE THEM (REAL MONEY)")
+        if acct.get("trading_blocked"):
+            raise OrderError("broker_rejected", f"{b.label.upper()} SAYS TRADING IS BLOCKED FOR THIS ACCOUNT")
+        if replace is not None:
+            current = next((o for o in await b.open_orders() if o["id"] == replace), None)
+            if current is None:
+                raise OrderError("not_found", "THE ORDER TO REPLACE IS NOT OPEN")
+            if current["symbol"] != order.symbol or current["side"] != order.side:
+                raise OrderError("bad_request", "A REPLACE CANNOT CHANGE THE SYMBOL OR THE SIDE: CANCEL AND ENTER A NEW ORDER")
+        price = order.ref_price()
+        price_note = "ORDER PRICE" if price is not None else None
+        if price is None:
+            price, price_note = await self.price_fn(order.symbol)
+        try:
+            positions = await b.positions()
+            gross = sum(abs(p["market_value"]) for p in positions if p.get("market_value") is not None)
+            gross_ok = all(p.get("market_value") is not None for p in positions)
+            held = sum(p["qty"] for p in positions if p["symbol"] == order.symbol)
+        except OrderError:
+            gross, gross_ok, held = None, False, None
+        m = await self.store.mandate()
+        check = mandate_mod.check(order, m, price, gross if gross_ok else None, held, await self.store.trades_today())
+        fp = fingerprint(order, mode, acct["id"] + (f"|replace:{replace}" if replace else ""))
+        return {"broker": b, "account": acct, "mode": mode, "check": check, "price": price, "price_note": price_note, "fp": fp,
+                "mandate": m.public(), "kill": False}
+
+    @staticmethod
+    def _facts(order: Order, ctx: dict | None = None, **extra) -> dict:
+        d = {"order": order.public(), **extra}
+        if ctx:
+            d.update(acct_tail=ctx["account"]["id"][-4:], price=ctx["price"], mandate_ok=ctx["check"]["ok"])
+        return d
+
+    async def preview(self, body, replace: str | None = None) -> dict:
+        """Everything the confirm step shows: the order, mode, account, the mandate check, and (only if all of it passes) a one-time token."""
+        order = Order.from_body(body)
+        try:
+            ctx = await self._gate(order, replace)
+        except OrderError as e:
+            await self.ledger.event("refused", order.broker, EXPECTED_MODE.get(order.broker, "-"), **self._facts(order), reason=str(e), kind=e.kind, step="preview")
+            raise
+        out = {"order": order.public(), "line": order.line(), "replace": replace, "broker": order.broker, "mode": ctx["mode"], "account": ctx["account"],
+               "price": ctx["price"], "price_note": ctx["price_note"], "check": ctx["check"], "mandate": ctx["mandate"],
+               "note": ctx["broker"].note or None, "token": None, "token_ttl_s": None}
+        if ctx["check"]["ok"]:
+            out["token"], out["token_ttl_s"] = self.tokens.issue(ctx["fp"])
+            await self.ledger.event("confirm_issued", order.broker, ctx["mode"], account=ctx["account"]["id"], **self._facts(order, ctx), replace=replace)
+        else:
+            await self.ledger.event("refused", order.broker, ctx["mode"], account=ctx["account"]["id"], **self._facts(order, ctx), step="mandate",
+                                    reason="; ".join(c["detail"] for c in ctx["check"]["checks"] if not c["ok"]), kind="mandate")
+        return out
+
+    async def submit(self, body, token, replace: str | None = None) -> dict:
+        order = Order.from_body(body)
+        async with self.lock:
+            try:
+                ctx = await self._gate(order, replace)
+                if not ctx["check"]["ok"]:
+                    raise OrderError("mandate", "MANDATE REFUSES THIS ORDER: " + "; ".join(c["detail"] for c in ctx["check"]["checks"] if not c["ok"]),
+                                     {"check": ctx["check"]})
+                self.tokens.consume(token, ctx["fp"])
+                if (await self.store.kill()).get("on"):  # read again right before sending
+                    raise OrderError("kill_switch", "KILL SWITCH IS ON: NO NEW ORDERS UNTIL ORD UNKILL")
+            except OrderError as e:
+                await self.ledger.event("refused", order.broker, EXPECTED_MODE.get(order.broker, "-"), **self._facts(order), reason=str(e), kind=e.kind, step="submit")
+                raise
+            b, mode, acct = ctx["broker"], ctx["mode"], ctx["account"]["id"]
+            client_id = "OT" + uuid.uuid4().hex[:14]
+            # Written first: if the process dies during the call, the ledger still shows an order may be at the broker.
+            await self.ledger.event("submitted", b.id, mode, client_id, acct, **self._facts(order, ctx), replace=replace)
+            try:
+                res = await (b.replace(replace, order) if replace else b.submit(order, client_id))
+            except OrderError as e:
+                await self.ledger.event("failed", b.id, mode, client_id, acct, **self._facts(order, ctx), reason=str(e), kind=e.kind)
+                # A refusal by the broker counts toward the daily cap like any sent order; "unavailable" may have reached it, so it counts too.
+                if not replace:
+                    await self.store.log_order(b.id, mode, client_id, None, order.symbol, order.side, order.qty, "FAILED" if e.kind == "broker_rejected" else "UNKNOWN")
+                raise
+            if not replace:
+                await self.store.log_order(b.id, mode, client_id, res.get("id"), order.symbol, order.side, order.qty, res.get("status") or "NEW")
+            await self.ledger.event("replace" if replace else "accepted", b.id, mode, client_id, acct, **self._facts(order, ctx), broker_order_id=res.get("id"),
+                                    status=res.get("status"))
+            return {"order": res, "client_id": client_id, "mode": mode, "broker": b.id}
+
+    # --- cancel and kill ---
+    async def cancel(self, broker_id: str, order_id: str) -> dict:
+        b = self.broker(broker_id)
+        acct = await self._ready_account(b)
+        try:
+            await b.cancel(order_id)
+        except OrderError as e:
+            await self.ledger.event("cancel_failed", b.id, acct["mode"], order_id, acct["id"], reason=str(e), kind=e.kind)
+            raise
+        await self.ledger.event("cancel", b.id, acct["mode"], order_id, acct["id"])
+        return {"cancelled": order_id, "broker": b.id}
+
+    async def kill(self) -> dict:
+        """Block new orders first (persisted), void every confirm token, then cancel everything at every connected broker."""
+        st = await self.store.set_kill(True)
+        self.tokens.clear()
+        await self.ledger.event("kill_on", at=st["at"])
+        results: dict[str, dict] = {}
+
+        async def one(b: Broker) -> None:
+            if b.not_ready() is not None:
+                results[b.id] = {"ok": None, "detail": "NOT CONNECTED: NOTHING TO CANCEL", "cancelled": 0, "failed": 0}
+                return
+            try:
+                async with self.lock:  # an order that was already past the gate finishes first, then it is cancelled with the rest
+                    rows = await b.cancel_all()
+                ok = [r for r in rows if r["ok"]]
+                results[b.id] = {"ok": len(ok) == len(rows), "detail": f"{len(ok)} OF {len(rows)} OPEN ORDERS CANCELLED", "cancelled": len(ok),
+                                 "failed": len(rows) - len(ok)}
+            except Exception as e:  # noqa: BLE001 - one broker failing must not stop the others
+                results[b.id] = {"ok": False, "detail": redact(str(e))[:200] or type(e).__name__, "cancelled": 0, "failed": -1}
+            await self.ledger.event("kill_cancel_all", b.id, EXPECTED_MODE.get(b.id, "-"), **results[b.id])
+
+        await asyncio.gather(*(one(b) for b in self.brokers.values()))
+        return {"kill": {"on": True, "at": st["at"]}, "brokers": results}
+
+    async def unkill(self) -> dict:
+        st = await self.store.set_kill(False)
+        await self.ledger.event("kill_off", at=st["at"])
+        return {"kill": {"on": False, "at": st["at"]}}
+
+    # --- settings ---
+    async def set_live(self, on: bool, phrase: str | None) -> dict:
+        if on and phrase != LIVE_PHRASE:
+            raise OrderError("bad_request", f"TO TURN LIVE ORDERS ON TYPE: {LIVE_PHRASE}")
+        await self.store.set_live(on)
+        if not on:
+            self.tokens.clear()
+        await self.ledger.event("live_on" if on else "live_off")
+        return {"live_enabled": on}
+
+    async def set_mandate(self, raw) -> dict:
+        m = await self.store.set_mandate(raw)
+        self.tokens.clear()  # a token was checked against the old mandate
+        await self.ledger.event("mandate_changed", mandate=m.public())
+        return m.public()
+
+    # --- fills into a portfolio ---
+    async def import_fills(self, broker_id: str, portfolio: str) -> dict:
+        b = self.broker(broker_id)
+        acct = await self._ready_account(b)
+        done = await self.store.imported_ids(b.id)
+        fills = [f for f in await b.fills_today() if f["fill_id"] not in done]
+        if not fills:
+            return {"added": 0, "portfolio": portfolio, "detail": "NO NEW FILLS TODAY"}
+        lots = [{"symbol": f["symbol"], "qty": f["qty"] if f["side"] == "buy" else -f["qty"], "cost": f["price"], "currency": f["currency"],
+                 "notes": f"{b.label} {acct['mode']} order {f['order_id']}"[:200]} for f in fills]
+        try:
+            res = await Portfolios(self.db).edit(portfolio, add=lots)
+        except UserDataError as e:
+            raise OrderError("bad_request", f"PORTFOLIO: {e}") from e
+        await self.store.mark_imported(b.id, fills, res["name"])
+        await self.ledger.event("import_fills", b.id, acct["mode"], account=acct["id"], portfolio=res["name"], fills=len(fills),
+                                orders=sorted({str(f.get("order_id")) for f in fills}))
+        return {"added": len(fills), "portfolio": res["name"], "detail": f"{len(fills)} FILLS ADDED AS LOTS TO {res['name']}"}
diff --git a/backend/openterm/orders/store.py b/backend/openterm/orders/store.py
new file mode 100644
index 0000000..36b66fd
--- /dev/null
+++ b/backend/openterm/orders/store.py
@@ -0,0 +1,89 @@
+"""SQLite side of orders: the mandate, the live switch and the kill switch (kv rows), the sent-orders log behind the daily cap, and the record of
+fills already added to a portfolio. The tables come from migration 17 (db.py)."""
+
+from __future__ import annotations
+
+import time
+
+import aiosqlite
+import orjson
+
+from . import mandate as mandate_mod
+from .errors import OrderError
+
+K_MANDATE, K_SETTINGS, K_KILL = "orders.mandate", "orders.settings", "orders.kill"
+
+
+def today() -> str:
+    return time.strftime("%Y-%m-%d")  # the machine's local day
+
+
+class OrdersStore:
+    def __init__(self, db: aiosqlite.Connection):
+        self.db = db
+
+    async def _get(self, key: str, default: dict) -> dict:
+        async with self.db.execute("SELECT value FROM kv WHERE key=?", (key,)) as cur:
+            row = await cur.fetchone()
+        if not row:
+            return dict(default)
+        try:
+            v = orjson.loads(row[0])
+        except orjson.JSONDecodeError:
+            return dict(default)
+        return v if isinstance(v, dict) else dict(default)
+
+    async def _put(self, key: str, value: dict) -> None:
+        await self.db.execute("INSERT INTO kv (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value=excluded.value", (key, orjson.dumps(value)))
+        await self.db.commit()
+
+    # --- mandate ---
+    async def mandate(self) -> mandate_mod.Mandate:
+        raw = await self._get(K_MANDATE, {})
+        try:
+            return mandate_mod.parse(raw)
+        except OrderError:  # a damaged stored document must not become a permissive one: the default allows nothing
+            return mandate_mod.Mandate()
+
+    async def set_mandate(self, raw) -> mandate_mod.Mandate:
+        m = mandate_mod.parse(raw)
+        await self._put(K_MANDATE, m.public())
+        return m
+
+    # --- live switch ---
+    async def live_enabled(self) -> bool:
+        return (await self._get(K_SETTINGS, {})).get("live") is True
+
+    async def set_live(self, on: bool) -> None:
+        await self._put(K_SETTINGS, {"live": bool(on), "at": time.time()})
+
+    # --- kill switch ---
+    async def kill(self) -> dict:
+        return await self._get(K_KILL, {"on": False})
+
+    async def set_kill(self, on: bool) -> dict:
+        v = {"on": bool(on), "at": time.time()}
+        await self._put(K_KILL, v)
+        return v
+
+    # --- sent orders ---
+    async def log_order(self, broker: str, mode: str, client_id: str, broker_order_id: str | None, symbol: str, side: str, qty: float, status: str) -> None:
+        await self.db.execute("INSERT INTO orders_log (at, day, broker, mode, client_id, broker_order_id, symbol, side, qty, status) VALUES (?,?,?,?,?,?,?,?,?,?)",
+                              (time.time(), today(), broker, mode, client_id, broker_order_id, symbol, side, qty, status))
+        await self.db.commit()
+
+    async def trades_today(self) -> int:
+        async with self.db.execute("SELECT COUNT(*) FROM orders_log WHERE day=?", (today(),)) as cur:
+            (n,) = await cur.fetchone()
+        return int(n)
+
+    # --- fills added to a portfolio ---
+    async def imported_ids(self, broker: str) -> set[str]:
+        async with self.db.execute("SELECT fill_id FROM orders_imported WHERE broker=?", (broker,)) as cur:
+            return {r[0] for r in await cur.fetchall()}
+
+    async def mark_imported(self, broker: str, fills: list[dict], portfolio: str) -> None:
+        now = time.time()
+        await self.db.executemany("INSERT OR IGNORE INTO orders_imported (broker, fill_id, portfolio, order_id, at) VALUES (?,?,?,?,?)",
+                                  [(broker, f["fill_id"], portfolio, str(f.get("order_id") or ""), now) for f in fills])
+        await self.db.commit()
