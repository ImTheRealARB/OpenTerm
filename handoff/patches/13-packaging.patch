diff --git a/Dockerfile b/Dockerfile
index 8dee5e7..9bb1eb3 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,7 +1,8 @@
 # OpenTerm: one image that serves the API, the WebSocket and the built frontend on :8000.
 #   docker build -t openterm .
 #   docker run --rm -p 8000:8000 -v openterm-data:/data openterm
-# Not verified on the machine that wrote it (Docker was not installed). See docs/RELEASE_NOTES.md.
+# Built and run on Linux (see docs/DESKTOP.md). Behind a TLS-intercepting proxy, pass your CA with a local-only
+# override rather than editing this file (docs/DESKTOP.md, "Docker behind a proxy").
 
 # --- stage 1: build the frontend ---
 FROM node:22-alpine AS web
@@ -16,6 +17,7 @@ FROM python:3.12-slim AS run
 COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
 ENV UV_COMPILE_BYTECODE=1 \
     UV_LINK_MODE=copy \
+    UV_NO_CACHE=1 \
     PYTHONUNBUFFERED=1 \
     OPENTERM_HOST=0.0.0.0 \
     OPENTERM_PORT=8000 \
@@ -30,7 +32,7 @@ COPY config.yaml /app/config.yaml
 COPY --from=web /src/frontend/dist /app/frontend/dist
 RUN uv sync --frozen --no-dev \
     && mkdir -p /data \
-    && useradd --system --uid 10001 openterm \
+    && useradd --no-create-home --uid 10001 --user-group openterm \
     && chown -R openterm /data
 USER openterm
 VOLUME /data
